{
  "name": "dsh-minimax-connect",
  "displayName": "DSH Connect MiniMax",
  "description": "Use the MiniMax Code (Mavis) subscription already signed in on this machine as a DSH model provider, with self-renewing credentials, a points panel and daily check-in.",
  "version": "0.1.0-dsh021rc2.3",
  "author": "VICqiufeeng",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.2"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test/*.test.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VICqiufeeng/dsh-minimax-connect.git"
  },
  "homepage": "https://github.com/VICqiufeeng/dsh-minimax-connect#readme",
  "bugs": {
    "url": "https://github.com/VICqiufeeng/dsh-minimax-connect/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minimax",
    "minimax-code",
    "mavis",
    "llm-provider",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@earendil-works/pi-ai": "^1.1.0",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/host-compat.test.mjs test/provider-contract.test.mjs test/rc2-provider.test.mjs test/renewal-safety.test.mjs"
  }
}
